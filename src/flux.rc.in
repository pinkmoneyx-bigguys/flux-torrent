#pragma code_page(65001) // UTF-8

IDI_ICON1 ICON "@FLUX_ICON@"
IDI_ICON2 ICON "@QBT_FILE_ICON@"

#include <windows.h>

#ifndef DEBUG
#define VER_DEBUG                   0
#else
#define VER_DEBUG                   VS_FF_DEBUG
#endif

1 VERSIONINFO
FILEVERSION     @FLUX_VERSION_MAJOR@,@FLUX_VERSION_MINOR@,@FLUX_VERSION_PATCH@,0
PRODUCTVERSION  @FLUX_VERSION_MAJOR@,@FLUX_VERSION_MINOR@,@FLUX_VERSION_PATCH@,0
FILEFLAGSMASK   VER_DEBUG
FILEFLAGS       VER_DEBUG
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Flux"
            VALUE "FileDescription",  "Flux Torrent"
            VALUE "FileVersion",      "@FLUX_VERSION@"
            VALUE "InternalName",     "Flux"
            VALUE "LegalCopyright",   "Flux contributors. Based on qBittorrent, GNU GPL v2 or later."
            VALUE "OriginalFilename", "Flux.exe"
            VALUE "ProductName",      "Flux Torrent"
            VALUE "ProductVersion",   "@FLUX_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
